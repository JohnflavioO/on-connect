# Copy to deploy/.env on the server (chmod 600). Never commit the real file.

# Public hostname of the API. Its DNS A record must point at the VPS before
# the first start, or Caddy cannot obtain the TLS certificate.
API_DOMAIN=

# Contact address for Let's Encrypt expiry notices.
ACME_EMAIL=

# Supabase session pooler (port 5432) as the onconnect_app role. The direct
# db.<ref>.supabase.co host is IPv6-only, and transaction mode (6543) breaks
# the per-request transaction. TLS is verified against deploy/supabase-ca.crt:
# postgresql://onconnect_app.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/run/certs/supabase-ca.crt
DATABASE_URL=

# HMAC key for API-key verifiers (openssl rand -base64 48). Rotating it
# invalidates every issued API key.
API_KEY_PEPPER=

# Sessions process (WhatsApp Web) and worker (webhook delivery). Same pooler
# URL format as DATABASE_URL, but for the onconnect_system role, which works
# across every client.
SYSTEM_DATABASE_URL=

# 32 random bytes (openssl rand -base64 32). Encrypts webhook signing secrets
# in the database; used by the api (to seal) and the worker (to sign).
# Losing or changing it makes every endpoint secret unreadable: each one must
# then be rotated (POST /v1/webhook-endpoints/:id/rotate-secret).
WEBHOOK_SECRET_KEY=

# 32 random bytes (openssl rand -base64 32). Encrypts received media on disk
# and signs the media links given to integrators; used by api and sessions.
# Losing or changing it makes every stored file and media link unusable.
MEDIA_KEY=

# Received media older than this many days is deleted (default 90).
# MEDIA_RETENTION_DAYS=90

# Super-admin panel at https://<API_DOMAIN>/admin/login.
# ADMIN_PASSWORD_HASH is a bcrypt hash made on the server with
#   docker run --rm caddy:2-alpine caddy hash-password
# and must stay in single quotes (it contains $ signs).
ADMIN_USER=
ADMIN_PASSWORD_HASH=''
# At least 32 random characters (openssl rand -hex 32). Caddy sends it to
# the panel, which refuses any request without it.
ADMIN_PROXY_SECRET=

# 32 random bytes (openssl rand -base64 32). Encrypts WhatsApp Web session keys
# in Redis. Losing or changing it forces every number to scan the QR again.
SESSION_STATE_KEY=

# Meta WhatsApp Cloud API (official). Optional: leave empty to disable.
# Webhook URL to give Meta: https://<API_DOMAIN>/webhooks/meta
# META_APP_SECRET: the app's secret (App settings > Basic). It checks that
#   each webhook really comes from Meta.
# META_VERIFY_TOKEN: any random text you choose (openssl rand -hex 24); type
#   the same value in Meta's webhook form.
# META_ACCESS_TOKEN: permanent token of a system user with
#   whatsapp_business_messaging and whatsapp_business_management.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
# META_GRAPH_VERSION=v23.0
# Embedded Signup: the app id (not secret) lets the sessions process swap a
# customer's signup code for their token, with META_APP_SECRET above.
META_APP_ID=

LOG_LEVEL=info
WORKER_CONCURRENCY=10
