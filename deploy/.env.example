# Copy to deploy/.env on the server (chmod 600). Never commit the real file.

# Public hostname of the API. Its DNS A record must point at the VPS before
# the first start, or Caddy cannot obtain the TLS certificate.
API_DOMAIN=

# Contact address for Let's Encrypt expiry notices.
ACME_EMAIL=

# Supabase session pooler (port 5432) as the onconnect_app role. The direct
# db.<ref>.supabase.co host is IPv6-only, and transaction mode (6543) breaks
# the per-request transaction. TLS is verified against deploy/supabase-ca.crt:
# postgresql://onconnect_app.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/run/certs/supabase-ca.crt
DATABASE_URL=

# HMAC key for API-key verifiers (openssl rand -base64 48). Rotating it
# invalidates every issued API key.
API_KEY_PEPPER=

# Sessions process (WhatsApp Web) and worker (webhook delivery). Same pooler
# URL format as DATABASE_URL, but for the onconnect_system role, which works
# across every client.
SYSTEM_DATABASE_URL=

# 32 random bytes (openssl rand -base64 32). Encrypts webhook signing secrets
# in the database; used by the api (to seal) and the worker (to sign).
# Losing or changing it makes every endpoint secret unreadable: each one must
# then be rotated (POST /v1/webhook-endpoints/:id/rotate-secret).
WEBHOOK_SECRET_KEY=

# 32 random bytes (openssl rand -base64 32). Encrypts WhatsApp Web session keys
# in Redis. Losing or changing it forces every number to scan the QR again.
SESSION_STATE_KEY=

LOG_LEVEL=info
WORKER_CONCURRENCY=10
