{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	request_body {
		max_size 2MB
	}

	# Health probes are for the internal network only.
	@health path /health /health/*
	respond @health 404

	# Public site and console. The console handles credentials and sessions.
	@console path / /assets/on-connect.css /admin /admin/*
	handle @console {
		reverse_proxy admin:8081 {
			header_up X-OnConnect-Admin-Secret {$ADMIN_PROXY_SECRET}
			header_up X-OnConnect-Login-IP {http.request.remote.host}
			header_up -X-OnConnect-Admin-User
		}
	}

	handle {
		reverse_proxy api:8080 {
			health_uri /health/ready
			health_interval 10s
			health_timeout 3s
			# Only the console routes may carry these.
			header_up -X-OnConnect-Admin-Secret
			header_up -X-OnConnect-Admin-User
			header_up -X-OnConnect-Login-IP
		}
	}

	log {
		output stdout
		# A media link's token is the credential to that file: never logged.
		format filter {
			wrap json
			fields {
				request>uri regexp ^/media/[^/?#]+ /media/[REDACTED]
				request>headers>Authorization delete
				request>headers>Cookie delete
				resp_headers>Set-Cookie delete
			}
		}
	}
}
