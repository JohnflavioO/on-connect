# Local development. Copy to .env (never committed).
# Only variables the code reads today are active; the rest are listed as
# comments and become required in the pull request that starts using them.

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# API
API_HOST=0.0.0.0
API_PORT=8080
PUBLIC_API_BASE_URL=http://localhost:8080
RATE_LIMIT_MAX_PER_MINUTE=300

# Worker
WORKER_CONCURRENCY=10

# Redis / BullMQ (start it with: docker compose up -d)
REDIS_URL=redis://localhost:6379

# PostgreSQL as the onconnect_app role (never postgres or service_role).
DATABASE_URL=postgresql://onconnect_app:change-me@localhost:5432/postgres

# HMAC key for API-key verifiers, at least 32 characters.
# Generate with: openssl rand -base64 48
# Changing it invalidates every issued API key.
API_KEY_PEPPER=

# Worker: webhook delivery as the onconnect_system role.
SYSTEM_DATABASE_URL=postgresql://onconnect_system:change-me@localhost:5432/postgres

# Encrypts webhook signing secrets (api seals, worker opens).
# Generate with: openssl rand -base64 32
WEBHOOK_SECRET_KEY=

# Received media: encryption/signing key and local folder (api + sessions).
# Generate with: openssl rand -base64 32
MEDIA_KEY=
MEDIA_DIR=./.media

